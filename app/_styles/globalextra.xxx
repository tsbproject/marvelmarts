@import "tailwindcss";
@plugin "@tailwindcss/typography";

@theme {
  /* --- CUSTOM BREAKPOINTS --- */
  --breakpoint-xs: 400px; 
  --breakpoint-sm: 500px; 
  --breakpoint-md: 600px; 
  --breakpoint-lg: 900px;
  --breakpoint-xl: 1100px;
  --breakpoint-2xl: 1200px;

  /* --- BRAND COLORS --- */
  --color-accent-navy: var(--accent-navy);
  --color-brand-primary: var(--brand-primary);
  --color-brand-light: var(--brand-orange-light);
  --color-neutral-white: var(--brand-white);
  --color-neutral-light: var(--brand-ghost);
  --color-neutral-gray: var(--brand-gray);
  --color-neutral-dark: var(--brand-black);

  /* --- DYNAMIC FONT SIZES (V4 mapping) --- */
  /* FIXED: We only scale these specific utilities. 
     We use 'rem' so they respond to the 'html' font-size. */
  --font-size-xs: calc(0.75rem * var(--body-font-scale, 1));
  --font-size-sm: calc(0.875rem * var(--body-font-scale, 1));
  --font-size-base: calc(1rem * var(--body-font-scale, 1));
  --font-size-lg: calc(1.125rem * var(--body-font-scale, 1));
  --font-size-xl: calc(1.25rem * var(--heading-font-scale, 1));
  --font-size-2xl: calc(1.5rem * var(--heading-font-scale, 1));
  --font-size-3xl: calc(1.875rem * var(--heading-font-scale, 1));
  --font-size-4xl: calc(2.25rem * var(--heading-font-scale, 1));
}

:root {
  --accent-navy: #002B5B;
  --brand-primary: #F7931E;
  --brand-orange-light: #FFE8CC;
  --brand-white: #FFFFFF;
  --brand-ghost: #F8F8F8;
  --brand-gray: #4B4B4B;
  --brand-black: #1E1E1E;
  
  /* Defaults: Always use 16px to keep Tailwind's rem math consistent */
  --base-font-size: 16px;
  --heading-font-scale: 1.0; 
  --body-font-scale: 1.0;
  --header-font-scale: 1.0;
  --footer-font-scale: 1.0;
  --carousel-font-scale: 1.0;
}

@layer base {
  #design-system-root {
    /* This makes every 'rem' unit inside this div calculate 
       based on the slider value (e.g., 10px) */
    font-size: var(--base-font-size, 10px);
  }

  /* Ensure body text behaves relative to the wrapper */
  #design-system-root body {
    font-size: calc(1rem * var(--body-font-scale, 1));
  }
}

@layer base {
  html {
    /* This is the master control. Setting this to 16px fixes the layout. */
    /* font-size: var(--base-font-size, 16px)!important;; */
    font-size: 16px !important;
    overflow-x: hidden;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  body {
    @apply bg-neutral-light text-neutral-dark;
    /* REMOVED calc from here to prevent double-scaling with @theme variables */
    /* font-size: calc(1rem * var(--body-font-scale, 1)); */
    font-size: calc(1rem * var(--text-scale-factor, 1) * var(--body-font-scale, 1));
    line-height: 1.5;
    
  }

  /* --- ZONE OVERRIDES (The Enterprise Controller) --- */
  
  /* 1. Header Logic */
  header {
    /* Shadowing the variables locally so utilities inside react to the zone scale */
    --body-font-scale: var(--header-font-scale) !important;
    --heading-font-scale: var(--header-font-scale) !important;
  }

  /* 2. EcommerceCarousel Logic */
  #EcommerceCarousel, .ecommerce-carousel {
    --body-font-scale: var(--carousel-font-scale) !important;
    --heading-font-scale: var(--carousel-font-scale) !important;
  }

  /* 3. Footer Logic */
  footer {
    --body-font-scale: var(--footer-font-scale) !important;
    --heading-font-scale: var(--footer-font-scale) !important;
  }

  /* Global Tag Scaling - Uses 'em' to multiply against the utility size */
  h1, h2, h3, h4, h5, h6 {
    font-size: calc(1em * var(--text-scale-factor, 1) * var(--heading-font-scale, 1));
    line-height: 1.2;
    font-weight: 900;
  }

  input, textarea, select, button, label {
    font-size: inherit;
    font-family: inherit;
  }

  /* --- ISOLATION LAYER (Dashboard Fix) --- */
  /* This prevents the Admin pages from breaking when you play with sliders */
  .design-system-isolated, 
  [data-admin-panel="true"] {
    --body-font-scale: 1.0 !important;
    --heading-font-scale: 1.0 !important;
    --header-font-scale: 1.0 !important;
    --footer-font-scale: 1.0 !important;
    --carousel-font-scale: 1.0 !important;
    --base-font-size: 16px !important;
  }

  .design-system-isolated :where(h1, h2, h3, h4, p, span, label, input, select, button, textarea) {
    font-size: revert !important; 
    line-height: revert !important;
  }
}

@layer utilities {
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fadeIn {
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes spin-slow {
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 2s linear infinite;
  }
}

/* Custom scrollbar */
.scrollbar-accent::-webkit-scrollbar { width: 8px; }
.scrollbar-accent::-webkit-scrollbar-track { background: #f1f1f1; }
.scrollbar-accent::-webkit-scrollbar-thumb {
  background-color: var(--accent-navy);
  border-radius: 4px;
}
.scrollbar-accent {
  scrollbar-width: thin;
  scrollbar-color: var(--accent-navy) #f1f1f1;
}