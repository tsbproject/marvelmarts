generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  phoneNumber        String?
  passwordHash       String?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  name               String?
  permissions        Json?
  IsVerified         Boolean             @default(false)
  isSuspended        Boolean             @default(false)
  balance            Float               @default(0.0)
  roles              UserRole[]          @default([CUSTOMER])
  role               UserRole?
  walletBalance      Float               @default(0)
  phone              String?
  paymentTypes       PaymentTypes[]
  accounts           Account[]
  addresses          Address[]
  adminProfile       AdminProfile?
  bankAccount        BankAccount?
  cart               Cart?
  customerProfile    CustomerProfile?
  disputes           Dispute[]           @relation("UserDisputes")
  notifications      Notification[]
  orders             Order[]
  passwordResetToken PasswordResetToken?
  paymentMethods     PaymentMethod[]
  payouts            Payout[]
  reviews            Review[]
  sessions           Session[]
  vendorProfile      VendorProfile?
  verificationCodes  VerificationCode[]
  wallet             Wallet?
  wishlists          Wishlist[]
  conversations      Conversation[]      @relation("UserConversations")

  vendorFollows VendorFollow[]
}

model VerificationCode {
  id             String           @id @default(cuid())
  userId         String?
  email          String
  hashedPassword String?
  name           String?
  code           String
  type           VerificationType
  expiresAt      DateTime
  used           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  vendorData     Json?
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  permissions Json?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  firstName    String
  lastName     String
  phoneNumber  String
  storeName    String
  storePhone   String
  storeAddress String
  country      String
  state        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isVerified   Boolean  @default(false)

  followerCount    Int   @default(0)
  shippingScore    Int   @default(100) // Percentage
  qualityScore     Int   @default(100) // Percentage
  avgRating        Float @default(5.0)
  cancellationRate Int   @default(0) // Percentage

  bio             String?
  coverUrl        String?
  logoUrl         String?
  isSuspended     Boolean             @default(false)
  rejectionReason String?
  status          VendorStatus        @default(PENDING)
  verificationDoc String?
  accountName     String?
  accountNumber   String?
  bankName        String?
  facebook        String?
  instagram       String?
  twitter         String?
  whatsapp        String?
  balance         Decimal             @default(0.00) @db.Decimal(10, 2)
  lastSyncedAt    DateTime?
  productDone     Boolean             @default(false)
  profileDone     Boolean             @default(false)
  storeDone       Boolean             @default(false)
  businessDoc     String?
  identityDoc     String?
  locationDoc     String?
  payoutsDone     Boolean             @default(false)
  transactions    CreditTransaction[]
  disputes        Dispute[]
  orders          Order[]
  payouts         Payout[]
  products        Product[]
  boost           VendorBoost?
  onboarding      VendorOnboarding?
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  score           VendorScore?
  store           VendorStore?
  withdrawal      Withdrawal[]

  marketplaceTransactions MarketplaceTransaction[]

  vendorFollows VendorFollow[]
}

model VendorOnboarding {
  id              String        @id @default(cuid())
  vendorProfileId String        @unique
  profileDone     Boolean       @default(false)
  storeDone       Boolean       @default(false)
  productDone     Boolean       @default(false)
  completed       Boolean       @default(false)
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
}

model VendorStore {
  id              String        @id @default(cuid())
  vendorProfileId String        @unique
  slug            String        @unique
  name            String
  logo            String?
  banner          String?
  description     String?
  followers       Int           @default(0)
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
}

model VendorBoost {
  id                 String        @id @default(cuid())
  vendorProfileId    String        @unique
  credits            Int           @default(0)
  createdAt          DateTime      @default(now())
  plan               BoostPlan     @default(FREE)
  updatedAt          DateTime      @default(now()) @updatedAt
  exhaustedAlertSent Boolean       @default(false)
  lowCreditAlertSent Boolean       @default(false)
  vendorProfile      VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
}

model VendorFollow {
  id              String   @id @default(cuid())
  userId          String
  vendorProfileId String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorProfileId])
}

model CreditTransaction {
  id              String        @id @default(cuid())
  reference       String        @unique
  amount          Int
  platform        String
  status          String
  vendorProfileId String
  createdAt       DateTime      @default(now())
  emailSent       Boolean       @default(false)
  emailSentAt     DateTime?
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
}

model VendorScore {
  id              String        @id @default(cuid())
  vendorProfileId String        @unique
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])

  commissionRate Float @default(0.10)

  rating          Float      @default(0.0)
  fulfillmentRate Int        @default(100)
  reviewsCount    Int        @default(0)
  tier            VendorTier @default(BRONZE)

  updatedAt DateTime @updatedAt
}

enum VendorTier {
  BRONZE
  SILVER
  GOLD
}

model Dispute {
  id              String        @id @default(cuid())
  vendorProfileId String
  reason          String
  status          DisputeStatus @default(OPEN)
  createdAt       DateTime      @default(now())
  orderId         String
  description     String?
  raisedById      String
  raisedBy        User          @relation("UserDisputes", fields: [raisedById], references: [id])
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])
}

model Withdrawal {
  id              String        @id @default(cuid())
  vendorProfileId String
  amount          Float
  status          String        @default("PENDING")
  reference       String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])
}

model MarketplaceTransaction {
  id              String        @id @default(cuid())
  orderId         String        @unique
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  // The Financial Split
  grossAmount Float // Total paid by Customer (e.g., ₦10,000)
  platformFee Float // Subtracted Commission (e.g., ₦1,000)
  netAmount   Float // Actual Vendor Payout (e.g., ₦9,000)

  commissionRate Float // Snapshot of the rate used (e.g., 0.10)
  vendorTier     VendorTier // Tier at time of sale (BRONZE/SILVER/GOLD)

  status    TransactionStatus @default(SUCCESS)
  reference String            @unique
  createdAt DateTime          @default(now())

  @@index([vendorProfileId])
}

model Payout {
  id              String        @id @default(cuid())
  amount          Float
  status          PayoutStatus  @default(PENDING)
  vendorId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accountName     String?
  accountNumber   String?
  bankName        String?
  vendorProfileId String
  adminRemarks    String?
  processedAt     DateTime?
  reference       String        @unique @default(cuid())
  vendor          User          @relation(fields: [vendorId], references: [id])
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])

  @@index([vendorProfileId])
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VendorVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
  @@index([email])
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  parentId        String?
  position        Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  imageUrl        String?
  metaDescription String?
  metaTitle       String?
  isFeatured      Boolean    @default(false)
  parent          Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryToCategory")
  primaryProducts Product[]  @relation("PrimaryProductCategory")
  products        Product[]  @relation("ProductCategories")
}

model Product {
  id                String         @id @default(cuid())
  title             String
  slug              String         @unique
  description       String
  brand             String?
  price             Decimal        @db.Decimal(10, 2)
  discountPrice     Decimal?       @db.Decimal(10, 2)
  stock             Int            @default(0)
  rating            Float          @default(0)
  ratingCount       Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  categoryId        String?
  isFeatured        Boolean        @default(false)
  isPublished       Boolean        @default(true)
  lowStockThreshold Int?           @default(5)
  metaDescription   String?
  metaTitle         String?
  status            ProductStatus  @default(ACTIVE)
  sku               String?
  tags              String[]
  isFlashSale       Boolean        @default(false)
  isNewArrival      Boolean        @default(false)
  shippingMethod    String?
  weight            Float?
  isTrending        Boolean        @default(false)
  salesCount        Int            @default(0)
  vendorProfileId   String
  boostUntil        DateTime?
  cartItems         CartItem[]
  orderItems        OrderItem[]
  category          Category?      @relation("PrimaryProductCategory", fields: [categoryId], references: [id])
  vendorProfile     VendorProfile  @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  images            ProductImage[]
  reviews           Review[]
  variants          Variant[]
  wishlists         Wishlist[]
  categories        Category[]     @relation("ProductCategories")
  flashSales        FlashSale[]    @relation("ProductToFlashSale")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  name       String
  price      Decimal?    @db.Decimal(10, 2)
  stock      Int         @default(0)
  attributes Json?
  sku        String?     @unique
  cartItems  CartItem[]
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  title      String?
  body       String?
  createdAt  DateTime @default(now())
  approved   Boolean  @default(true)
  cons       String?
  flagged    Boolean  @default(false)
  pros       String?
  updatedAt  DateTime @default(now()) @updatedAt
  isVerified Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountValue Decimal  @db.Decimal(10, 2)
  isPercentage  Boolean  @default(true)
  limit         Int      @default(1)
  usedCount     Int      @default(0)
  expiryDate    DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model FlashSale {
  id        String    @id @default(cuid())
  name      String
  startTime DateTime
  endTime   DateTime
  discount  Float
  isActive  Boolean   @default(false)
  products  Product[] @relation("ProductToFlashSale")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String?
  variantId String?
  qty       Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
  variant   Variant? @relation(fields: [variantId], references: [id])
}

model Order {
  id                   String        @id @default(cuid())
  userId               String?
  status               String        @default("pending")
  subtotal             Decimal       @db.Decimal(10, 2)
  shipping             Decimal       @default(0) @db.Decimal(10, 2)
  tax                  Decimal       @default(0) @db.Decimal(10, 2)
  total                Decimal       @db.Decimal(10, 2)
  paymentIntentId      String?       @unique
  createdAt            DateTime      @default(now())
  apartment            String?
  city                 String?
  email                String?
  firstName            String?
  lastName             String?
  orderNotes           String?
  orderNumber          String        @unique @default("MARVEL-TEMP")
  phone                String?
  shippingAddress      String?
  shippingCity         String?
  shippingState        String?
  state                String?
  streetAddress        String?
  useDifferentShipping Boolean       @default(false)
  paymentStatus        Boolean       @default(false)
  emailSent            Boolean       @default(false)
  refundStatus         String?
  trackingNumber       String?
  refundReason         String?
  refundReference      String?       @unique
  cancelReason         String?
  vendorProfileId      String
  shippingFirstName    String?
  shippingLastName     String?
  paymentTypes         PaymentTypes?
  user                 User?         @relation(fields: [userId], references: [id])
  vendorProfile        VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  items                OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  qty       Int
  unitPrice Decimal  @db.Decimal(10, 2)
  imageUrl  String?
  title     String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
  variant   Variant? @relation(fields: [variantId], references: [id])
}

model Address {
  id      String  @id @default(cuid())
  userId  String
  label   String?
  line1   String
  line2   String?
  city    String
  state   String?
  country String
  zip     String
  phone   String?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HelpArticle {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String
  content    String
  keywords   String[]
  category   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  helpful    Int      @default(0)
  notHelpful Int      @default(0)

  @@index([title, slug])
}

model Ticket {
  id        String   @id @default(cuid())
  subject   String
  message   String
  status    String   @default("OPEN")
  userEmail String
  articleId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     String?
}

model Blog {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  excerpt    String?
  coverImage String?
  published  Boolean  @default(false)
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([slug])
}

model SiteSettings {
  id                     Int      @id @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  accentNavy             String?
  brandPrimary           String?
  brandOrangeLight       String?
  neutralWhite           String?
  neutralLight           String?
  neutralGray            String?
  neutralDark            String?
  layoutScale            Float?
  baseFontSize           Int?
  bodyFontScale          Float?
  headingFontScale       Float?
  headerFontScale        Float?
  footerFontScale        Float?
  carouselFontScale      Float?
  headerBg               String?
  headerText             String?
  headerBorder           String?
  showSearchBar          Boolean  @default(true)
  footerBg               String?
  footerText             String?
  showSocialIcons        Boolean  @default(true)
  productCardRadius      String?
  productCardShadow      String?
  productPriceColor      String?
  addToCartBg            String?
  addToCartText          String?
  showFeaturedProducts   Boolean  @default(true)
  showFlashSales         Boolean  @default(true)
  showFeaturedCategories Boolean  @default(true)
  showNewArrivals        Boolean  @default(true)
  showTestimonials       Boolean  @default(true)
  cartDrawerPosition     String?  @default("right")
  cartDrawerWidth        String?  @default("400px")
  helpMenuPosition       String?  @default("bottom-right")
  showEcommerceCarousel  Boolean  @default(true)
  showTrendingProducts   Boolean  @default(true)
  facebookUrl            String?
  footerBodyFontSize     Int?     @default(16)
  footerHeadingFontSize  Int?     @default(20)
  footerLogo             String?
  instagramUrl           String?
  twitterUrl             String?
  whatsappUrl            String?

  @@map("site_settings")
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model Conversation {
  id             String             @id @default(cuid())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  participantIds String[]
  type           ConversationType   @default(CUSTOMER_VENDOR)
  subject        String?
  status         ConversationStatus @default(OPEN)

  isGuest          Boolean @default(false)
  visitorName      String?
  visitorEmail     String?
  guestAccessToken String? @unique

  endedAt     DateTime?
  endedById   String?
  endedByRole String?

  deletedForUserIds String[] @default([])

  deletedByParticipantIds String[] @default([])

  messages     Message[]
  participants User[]    @relation("UserConversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String?
  senderName     String?
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  productId      String?
  productImage   String?
  productPrice   String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PaymentMethod {
  id          String   @id @default(cuid())
  userId      String
  provider    String
  providerId  String   @unique
  cardType    String?
  last4       String
  expiryMonth String
  expiryYear  String
  isDefault   Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Decimal             @default(0.0) @db.Decimal(10, 2)
  currency     String              @default("NGN")
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  amount      Decimal  @db.Decimal(10, 2)
  type        String
  status      String   @default("SUCCESS")
  reference   String   @unique
  description String?
  createdAt   DateTime @default(now())
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  bankName      String
  accountNumber String
  accountName   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CUSTOMER
}

enum BoostPlan {
  FREE
  BASIC
  PRO
  ULTRA
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_STARTED
  AWAITING_DOCUMENTS
  PENDING_REVIEW
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

enum VerificationType {
  CUSTOMER_REGISTRATION
  VENDOR_REGISTRATION
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum ConversationType {
  CUSTOMER_VENDOR
  VENDOR_ADMIN
  CUSTOMER_ADMIN
}

enum PaymentTypes {
  CARD
  BANK_TRANSFER
  WALLET
  CASH_ON_DELIVERY
}

enum TransactionType {
  TOPUP
  PURCHASE
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}
