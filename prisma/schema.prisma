generator client {
  provider = "prisma-client-js"
  engineType      = "library"  
}

datasource db {
  provider = "postgresql"

  

  
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  name               String?
  balance            Float    @default(0.0) // Track earnings here
  payouts            Payout[]
  permissions        Json?
  role               UserRole            @default(CUSTOMER)
  IsVerified         Boolean             @default(false)
  isSuspended        Boolean             @default(false) 

  // --- RELATIONS WITH CASCADE (Safe to delete automatically) ---
  accounts           Account[]           
  sessions           Session[]           
  addresses          Address[]           
  verificationCodes  VerificationCode[]  
  wishlists          Wishlist[]          
  cart               Cart?               
  
 
  adminProfile       AdminProfile?       @relation("AdminProfileUser")
  customerProfile    CustomerProfile?    @relation("CustomerProfileUser")
  vendorProfile      VendorProfile?      @relation("VendorProfileUser")

  conversations      Conversation[]      @relation("UserConversations")

  
  orders             Order[]
  reviews            Review[]

  notifications       Notification[]

  disputes           Dispute[]            @relation("UserDisputes")
  
  passwordResetToken PasswordResetToken?
}

model VerificationCode {
  id             String           @id @default(cuid())
  userId         String?
  email          String
  hashedPassword String?
  name           String?
  code           String
  type           VerificationType
  expiresAt      DateTime
  used           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  vendorData     Json?
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  permissions Json?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("AdminProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  
}

model VendorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation("VendorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  verificationDoc String?  // To store the Cloudinary URL

  // Social Media Handles
  instagram   String?
  twitter     String?
  facebook    String?
  whatsapp    String?

  // Financial Details (Payouts)
  bankName      String?
  accountNumber String?
  accountName   String?


  profileDone     Boolean  @default(false)
  storeDone       Boolean  @default(false)
  productDone     Boolean  @default(false)

  //Vendor Sales balance 
  balance          Decimal      @default(0.00) @db.Decimal(10, 2)

  lastSyncedAt     DateTime?

  payouts          Payout[]

  withdrawal       Withdrawal[]


  transactions CreditTransaction[] 
  



  




  
  // --- Existing Identity Fields ---
  firstName    String
  lastName     String
  storeName    String
  storePhone   String
  storeAddress String
  country      String
  state        String
  
  // Branding (Syncs with Phase 5: VendorStore)
  logoUrl      String?  // Store Business Logo
  coverUrl     String?  // Store Banner/Cover Photo
  bio          String?  @db.Text 

  // --- Roadmap Phase Relations ---
  // Phase 4: Onboarding Tracker
  onboarding   VendorOnboarding? 

  status       VendorStatus     @default(PENDING)
  rejectionReason  String?      @db.Text

  // Phase 5: Unique Store Identity & Slug
  store        VendorStore?      

  // Phase 6: Inventory Management
  products     Product[]         // Crucial: Fixes the Dashboard 'products' error

  // Phase 7: Order Management
  orders       Order[]           // Needed for 'New Orders' count

  // Phase 8: Visibility Boost System
  boost        VendorBoost?      

  // Phase 11: Reputation Score & Tiers
  score        VendorScore?      

  // Phase 12: Disputes & Seller Protection
  disputes     Dispute[]

  // Meta
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isVerified   Boolean  @default(false)
  isSuspended  Boolean   @default(false)
}

// PHASE 4: ONBOARDING TRACKER
model VendorOnboarding {
  id              String        @id @default(cuid())
  vendorProfileId String        @unique
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  profileDone     Boolean       @default(false)
  storeDone       Boolean       @default(false)
  productDone     Boolean       @default(false)
  completed       Boolean       @default(false)
}

// PHASE 5: VENDOR STORE (Unique Slugs & Metrics)
model VendorStore {
  id              String        @id @default(cuid())
  vendorProfileId String        @unique
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  slug            String        @unique // e.g., marvelmarts.com/store/tayo-shop
  name            String
  logo            String?
  banner          String?
  description     String?
  followers       Int           @default(0)
}

// PHASE 8: VENDOR BOOST SYSTEM
// 1. Add this Enum to your schema
enum BoostPlan {
  FREE
  BASIC
  PRO
  ULTRA
}

// 2. Update the VendorBoost model
model VendorBoost {
 id              String        @id @default(cuid())
  vendorProfileId String        @unique
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  credits         Int           @default(0)
  plan            BoostPlan     @default(FREE)
  createdAt       DateTime      @default(now())
  // Add @default(now()) temporarily so existing rows can be populated
  updatedAt       DateTime      @default(now()) @updatedAt
}

model CreditTransaction {
  id              String   @id @default(cuid())
  reference       String   @unique // Paystack Reference
  amount          Int      // Credits added
  platform        String   // "PAYSTACK" or "FLUTTERWAVE"
  status          String   @default("SUCCESS")
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])
  createdAt       DateTime @default(now())
}

// PHASE 11: VENDOR REPUTATION SCORE
model VendorScore {
  id              String        @id @default(cuid())
  vendorProfileId String        @unique
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  score           Int           @default(0)
  tier            VendorTier    @default(BRONZE)
}

// PHASE 12: DISPUTES
model Dispute {
  id              String        @id @default(cuid())
  orderId         String
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])
  reason          String
  status          DisputeStatus @default(OPEN)
  description     String?
  createdAt       DateTime      @default(now())

  // The actual ID field
  raisedById      String
  // Optional: Define the relation so you can fetch the user's name later
  raisedBy        User          @relation("UserDisputes", fields: [raisedById], references: [id])
}

enum VendorTier {
  BRONZE
  SILVER
  GOLD
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

model Withdrawal {
  id              String   @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])
  amount          Float
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  reference       String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payout {
  id          String   @id @default(cuid())
  amount      Float
  status      PayoutStatus @default(PENDING)
  vendorId    String
  vendor      User     @relation(fields: [vendorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reference String @unique @default("PENDING_REF")
  adminRemarks    String?       
  processedAt     DateTime?     

 
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id])

  // Bank snapshot (captures where the money was sent at that moment)
  accountName     String?
  accountNumber   String?
  bankName        String?

  @@index([vendorProfileId])
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}
model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("CustomerProfileUser", fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum VerificationType {
  CUSTOMER_REGISTRATION
  VENDOR_REGISTRATION
}

model VendorVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
  @@index([email])
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  parentId        String?
  position        Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  //Relations
  parent          Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryToCategory")
  products        Product[]


  imageUrl        String?    // for category image upload
  metaTitle       String?    // SEO title (≤ 60 chars)
  metaDescription String?    // SEO description (≤ 160 chars)
  isFeatured      Boolean    @default(false) 
}


// Product status enum for clarity
enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id                String         @id @default(cuid())
  title             String
  slug              String         @unique
  sku               String?
  description       String         @db.Text
  brand             String?
  tags              String[]
  price             Decimal        @db.Decimal(10, 2)
  salesCount        Int           @default(0)
  shippingMethod    String?
  weight            Float?
  discountPrice     Decimal?       @db.Decimal(10, 2)
  stock             Int            @default(0)
  lowStockThreshold Int?           @default(5)
  status            ProductStatus  @default(ACTIVE)
  rating            Float          @default(0)
  ratingCount       Int            @default(0)
  
  isFeatured      Boolean          @default(false)
  isFlashSale     Boolean          @default(false) 
  isNewArrival    Boolean          @default(false) 
  isTrending      Boolean          @default(false) 
  isPublished     Boolean          @default(true)

  boostUntil      DateTime?


  


  metaTitle         String?
  metaDescription   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  wishlists         Wishlist[]

  //RELATIONS
  categoryId        String?
  category          Category?      @relation(fields: [categoryId], references: [id])
  
  //Multi-Vendor Link
  // --- RELATION TO VENDOR ---
  vendorProfileId  String
  vendorProfile    VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  cartItems         CartItem[]
  orderItems        OrderItem[]
  images            ProductImage[]
  reviews           Review[]
  variants          Variant[]
  flashSales        FlashSale[] @relation("ProductToFlashSale")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

model Variant {
  id         String     @id @default(cuid())
  name       String
   sku       String?   @unique 
  price      Decimal?   @db.Decimal(10, 2)
  stock      Int        @default(0)
  attributes Json?      // flexible attributes like { "size": "M", "color": "Red" }
  productId  String
  product    Product    @relation(fields: [productId], references: [id])

  // Back-relations
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  body      String?
  pros      String?
  cons      String?
  approved  Boolean   @default(true)
  flagged   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  isVerified Boolean @default(false) 


  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique // e.g., "MARVEL20"
  discountValue Decimal   @db.Decimal(10, 2)
  isPercentage  Boolean   @default(true)
  limit         Int       @default(1) // Usage limits [cite: 114]
  usedCount     Int       @default(0)
  expiryDate    DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model FlashSale {
  id          String    @id @default(cuid())
  name        String    // e.g., "Black Friday Tactical Drop"
  startTime   DateTime
  endTime     DateTime  
  discount    Float     // Multiplier for all products in this sale
  isActive    Boolean   @default(false)
  products    Product[] @relation("ProductToFlashSale")
}







model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId]) // Prevents duplicate wishlist items
}




model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String?
  variantId String?
  qty       Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
  variant   Variant? @relation(fields: [variantId], references: [id])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @default("MARVEL-TEMP") 
  paymentStatus   Boolean     @default(false)
  userId          String?
  user            User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  trackingNumber String?


  
  
  refundStatus    String?     // Values: "none", "requested", "processing", "completed", "rejected"
  refundReason    String?  
  cancelReason    String?        @db.Text   
  refundReference String?     @unique // Store the specific Paystack/Stripe refund ID 

  emailSent   Boolean  @default(false) 

  
  
  // --- NEW ADDRESS FIELDS ---
  firstName       String?     
  lastName        String?
  email           String?
  phone           String?
  streetAddress   String?
  apartment       String?
  city            String?
  state           String?
  orderNotes      String?
  
  // Shipping Info (For "Ship to different address")
  useDifferentShipping Boolean @default(false)
  shippingFirstName    String?
  shippingLastName     String?
  shippingAddress      String?
  shippingCity         String?
  shippingState        String?
  // --------------------------

  status          String      @default("pending")
  subtotal        Decimal     @db.Decimal(10, 2)
  shipping        Decimal     @default(0) @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  paymentIntentId String?     @unique // This will store Paystack reference
  createdAt       DateTime    @default(now())
  items           OrderItem[]


  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
}



model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String?
  variantId  String?
  qty        Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])
  variant    Variant? @relation(fields: [variantId], references: [id])
  
  //  these to keep a "snapshot" in case product price/name changes later
  title       String?  
  imageUrl    String?
}


model Address {
  id      String  @id @default(cuid())
  userId  String
  label   String?
  line1   String
  line2   String?
  city    String
  state   String?
  country String
  zip     String
  phone   String?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CUSTOMER
}




model HelpArticle {
  id        String   @id @default(cuid())
  helpful     Int    @default(0)
  notHelpful  Int    @default(0)
  slug      String   @unique
  title     String
  excerpt   String   
  content   String   @db.Text
  keywords  String[] 
  category  String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title, slug]) // Makes searching faster
}

model Ticket {
  id          String   @id @default(cuid())
  subject     String
  message     String
  status      String   @default("OPEN") // OPEN, PENDING, CLOSED
  userEmail   String
  articleId   String?  // Optional: know which article triggered the ticket
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       String?  @db.Text 
}


model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String?  @db.Text
  coverImage  String?
  published   Boolean  @default(false)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}



model SiteSettings {
  id                    Int       @id @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accentNavy            String?
  brandPrimary          String?
  brandOrangeLight      String?
  neutralWhite          String?
  neutralLight          String?
  neutralGray           String?
  neutralDark           String?

  layoutScale           Float?
  baseFontSize          Int?
  bodyFontScale         Float?
  headingFontScale      Float?
  headerFontScale       Float?
  footerFontScale       Float?
  carouselFontScale     Float?

  headerBg              String?
  headerText            String?
  headerBorder          String?
  showSearchBar         Boolean   @default(true)

  footerBg              String?
  footerText            String?
  footerLogo            String?   // NEW
  footerBodyFontSize    Int?      @default(16)   // NEW
  footerHeadingFontSize Int?      @default(20)   // NEW
  showSocialIcons       Boolean   @default(true)
  facebookUrl           String?   // NEW
  instagramUrl          String?   // NEW
  twitterUrl            String?   // NEW
  whatsappUrl           String?   // NEW

  productCardRadius     String?
  productCardShadow     String?
  productPriceColor     String?
  addToCartBg           String?
  addToCartText         String?

  showFeaturedProducts  Boolean   @default(true)
  showEcommerceCarousel Boolean   @default(true)
  showFlashSales        Boolean   @default(true)
  showFeaturedCategories Boolean  @default(true)
  showTrendingProducts  Boolean   @default(true)
  showNewArrivals       Boolean   @default(true)
  showTestimonials      Boolean   @default(true)

  cartDrawerPosition    String?   @default("right")
  cartDrawerWidth       String?   @default("400px")
  helpMenuPosition      String?   @default("bottom-right")

    @@map("site_settings")  
}
model Conversation {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Participants - Can be any combination of User roles
  participantIds String[] 
  participants   User[]    @relation("UserConversations")
  
  // Metadata to help filter in the Dashboards
  type        ConversationType @default(CUSTOMER_VENDOR)
  subject     String?   // Useful for Admin tickets e.g. "Payout Issue"
  
  messages    Message[]
}

enum ConversationType {
  CUSTOMER_VENDOR
  VENDOR_ADMIN
  CUSTOMER_ADMIN
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderName     String?      
  content        String       @db.Text
  
  // New Fields for Product Context
  productId      String?
  productPrice   String?      // Store "price at time of inquiry"
  productImage   String?      
  
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}




model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // e.g., "DISPUTE", "ORDER", "PAYOUT"
  title     String
  message   String
  link      String?  
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}




model NewsletterSubscriber {
  id        String   @id @default(cuid()) // or uuid()
  email     String   @unique
  createdAt DateTime @default(now())
}


