generator client {
  provider = "prisma-client-js"
  engineType      = "library"  
}

datasource db {
  provider = "postgresql"

  
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  name               String?
  permissions        Json?
  role               UserRole            @default(CUSTOMER)
  IsVerified         Boolean             @default(false)
  isSuspended        Boolean             @default(false) 
  accounts           Account[]
  addresses          Address[]
  adminProfile       AdminProfile?       @relation("AdminProfileUser")
  cart               Cart?
  customerProfile    CustomerProfile?    @relation("CustomerProfileUser")
  products           Product[]
  orders             Order[]
  passwordResetToken PasswordResetToken?
  reviews            Review[]
  sessions           Session[]
  vendorProfile      VendorProfile?      @relation("VendorProfileUser")
  verificationCodes  VerificationCode[]

  wishlists          Wishlist[]
  

}

model VerificationCode {
  id             String           @id @default(cuid())
  userId         String?
  email          String
  hashedPassword String?
  name           String?
  code           String
  type           VerificationType
  expiresAt      DateTime
  used           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  vendorData     Json?
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  permissions Json?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("AdminProfileUser", fields: [userId], references: [id], onDelete: Cascade)
}

model VendorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  firstName    String
  lastName     String
  storeName    String
  storePhone   String
  storeAddress String
  country      String
  state        String
  
  // Branding & Customization
  logoUrl      String?  // Store Business Logo
  coverUrl     String?  // Store Banner/Cover Photo
  bio          String?  @db.Text // Store Description for customers
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isVerified   Boolean  @default(false)
  user         User     @relation("VendorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("CustomerProfileUser", fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VendorVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
  @@index([email])
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  parentId        String?
  position        Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  //Relations
  parent          Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryToCategory")
  products        Product[]


  imageUrl        String?    // for category image upload
  metaTitle       String?    // SEO title (≤ 60 chars)
  metaDescription String?    // SEO description (≤ 160 chars)
}


// Product status enum for clarity
enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id                String         @id @default(cuid())
  title             String
  slug              String         @unique
  sku               String?
  description       String         @db.Text
  brand             String?
  tags              String[]
  price             Decimal        @db.Decimal(10, 2)
  shippingMethod String?
  weight         Float?
  discountPrice     Decimal?       @db.Decimal(10, 2)
  stock             Int            @default(0)
  lowStockThreshold Int?           @default(5)
  status            ProductStatus  @default(ACTIVE)
  rating            Float          @default(0)
  ratingCount       Int            @default(0)
  
  isFeatured      Boolean        @default(false)
  isFlashSale     Boolean  @default(false) // Add this
  isNewArrival    Boolean  @default(false) // Add this
  
  isPublished       Boolean        @default(true)
  


  metaTitle         String?
  metaDescription   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  wishlists         Wishlist[]

  //RELATIONS
  categoryId        String?
  category          Category?      @relation(fields: [categoryId], references: [id])
  
  //Multi-Vendor Link
  vendorId          String?        // ID of the User who owns this product
  vendor            User?          @relation(fields: [vendorId], references: [id])

  cartItems         CartItem[]
  orderItems        OrderItem[]
  images            ProductImage[]
  reviews           Review[]
  variants          Variant[]
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

model Variant {
  id         String     @id @default(cuid())
  name       String
   sku       String?   @unique 
  price      Decimal?   @db.Decimal(10, 2)
  stock      Int        @default(0)
  attributes Json?      // flexible attributes like { "size": "M", "color": "Red" }
  productId  String
  product    Product    @relation(fields: [productId], references: [id])

  // Back-relations
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  body      String?
  pros      String?
  cons      String?
  approved  Boolean   @default(true)
  flagged   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime @default(now()) @updatedAt


  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}



model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId]) // Prevents duplicate wishlist items
}




model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String?
  variantId String?
  qty       Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
  variant   Variant? @relation(fields: [variantId], references: [id])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @default("MARVEL-TEMP") 
  paymentStatus        Boolean     @default(false)
  userId          String
  user            User        @relation(fields: [userId], references: [id])

  emailSent   Boolean  @default(false) 

  
  
  // --- NEW ADDRESS FIELDS ---
  firstName       String?     
  lastName        String?
  email           String?
  phone           String?
  streetAddress   String?
  apartment       String?
  city            String?
  state           String?
  orderNotes      String?
  
  // Shipping (if different)
  useDifferentShipping Boolean @default(false)
  shippingAddress      String?
  shippingCity         String?
  shippingState        String?
  // --------------------------

  status          String      @default("pending")
  subtotal        Decimal     @db.Decimal(10, 2)
  shipping        Decimal     @default(0) @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  paymentIntentId String?     @unique // This will store Paystack reference
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}



model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String?
  variantId  String?
  qty        Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])
  variant    Variant? @relation(fields: [variantId], references: [id])
  
  //  these to keep a "snapshot" in case product price/name changes later
  title       String?  
  imageUrl    String?
}


model Address {
  id      String  @id @default(cuid())
  userId  String
  label   String?
  line1   String
  line2   String?
  city    String
  state   String?
  country String
  zip     String
  phone   String?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CUSTOMER
}

enum VerificationType {
  CUSTOMER_REGISTRATION
  VENDOR_REGISTRATION
}


model HelpArticle {
  id        String   @id @default(cuid())
  helpful     Int    @default(0)
  notHelpful  Int    @default(0)
  slug      String   @unique
  title     String
  excerpt   String   
  content   String   @db.Text
  keywords  String[] 
  category  String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title, slug]) // Makes searching faster
}

model Ticket {
  id          String   @id @default(cuid())
  subject     String
  message     String
  status      String   @default("OPEN") // OPEN, PENDING, CLOSED
  userEmail   String
  articleId   String?  // Optional: know which article triggered the ticket
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       String?  @db.Text 
}


model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String?  @db.Text
  coverImage  String?
  published   Boolean  @default(false)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}



model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}


model SiteSettings {
  id              Int      @id @default(1)
  footerDesc      String   @default("Africa's most trusted marketplace.")
  supportPhone    String   @default("+234 800-MARVEL")
  supportEmail    String   @default("help@marvelmarts.com")
  flashSaleActive Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}




